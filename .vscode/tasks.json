{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/SResult.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/SResult.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/SResult.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "coverage",
            "command": "dotnet",
            "dependsOn":"build",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/SResult.sln",
                "/p:CollectCoverage=true",
                "/p:CoverletOutputFormat=cobertura",
                "/p:CoverletOutput=${workspaceFolder}/SResult.tests/coverage/results/"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "coverage-html",
            "command": "reportgenerator",
            "dependsOn":"coverage",
            "type": "process",
            "args": [
                "-reports:${workspaceFolder}/SResult.tests/coverage/results/coverage.cobertura.xml",
                "-targetdir:${workspaceFolder}/SResult.tests/coverage/reports/html",
            ],
            "problemMatcher": "$msCompile"
        },
    ]
}